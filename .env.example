# Google Apps Script 웹 앱 배포 URL을 연결하면 상담 폼이 해당 주소로 전송됩니다.
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=
# 실제 GA4 웹 데이터 스트림의 측정 ID(G-로 시작)를 설정하면 분석과 기존 전환 이벤트가 활성화됩니다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# canonical, sitemap, robots.txt, llms.txt에 사용하는 운영 도메인입니다.
NEXT_PUBLIC_SITE_URL=https://geosang-support.vercel.app
